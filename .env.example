# Copy this file to .env and fill in your real keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Optional — power the "higher accuracy" (Cohere reranker) toggle.
# Trial key is tried first; prod key is the fallback when the trial key is
# rate-limited or hits its monthly cap. If neither is set, the toggle silently
# serves the fast hybrid result instead of erroring.
COHERE_API_KEY=your-cohere-trial-key-here
COHERE_API_KEY_PROD=your-cohere-prod-key-here
