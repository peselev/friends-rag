# Copy this file to .env and fill in your real keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Cohere rerank ("higher accuracy" demo mode). Optional — if unset, that mode
# falls back to the fast hybrid. Trial key is the default; prod key is the
# fallback used when the trial key is rate-limited or out of monthly allowance.
COHERE_API_KEY=your-cohere-trial-key-here
COHERE_API_KEY_PROD=your-cohere-prod-key-here
